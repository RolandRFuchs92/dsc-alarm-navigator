# dsc.iamonline.co.za — DSC Alarm Navigator (Next.js app in Docker).
# nginx terminates TLS and proxies to the container, which is published on
# 127.0.0.1:3000 only (docker run -p 127.0.0.1:3000:3000 ...). If you publish it
# on another host port, change proxy_pass below to match.
#
# Install on the server:
#   cp dsc.iamonline.co.za /etc/nginx/sites-available/
#   ln -s /etc/nginx/sites-available/dsc.iamonline.co.za /etc/nginx/sites-enabled/
#   nginx -t && systemctl reload nginx
#
# TLS: run `certbot --nginx -d dsc.iamonline.co.za` — certbot rewrites
# this file in place (adds the 443 block and the HTTP→HTTPS redirect).
# The app builds auth URLs from BETTER_AUTH_URL, so set that to the https URL.

server {
    listen 80;
    listen [::]:80;
    server_name dsc.iamonline.co.za;

    # The Content-Security-Policy comes from the app (a fresh nonce per request),
    # so it is not set here. These two are static and stay at the edge.
    add_header X-Content-Type-Options "nosniff" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;

    location / {
        proxy_pass http://127.0.0.1:3000;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-Host $host;
    }

    # Nothing in this site should be a dotfile (.git, .env, ...).
    location ~ /\. {
        deny all;
    }
}
